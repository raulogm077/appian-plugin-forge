            String idCorrelacion = java.util.UUID.randomUUID().toString();
            LOG.error("Error en {{CLASE}} [" + idCorrelacion + "]", e);
            errorOccurred = Boolean.TRUE;
            errorMessage = "Se produjo un error. Identificador de correlacion: " + idCorrelacion;
            throw new SmartServiceException.Builder(getClass(), e).build();
        }
